{
  "expo": {
    "name": "clau-garm",
    "slug": "clau-garm",
    "version": "0.0.1",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "android": {
      "package": "uy.clau.garm",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "clau-garm uses your location to show own-ship on the moving map."
      }
    },
    "platforms": ["android", "ios"],
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "clau-garm uses your location to show own-ship on the moving map."
        }
      ]
    ]
  }
}
